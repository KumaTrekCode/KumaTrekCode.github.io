{
  "name": "kumatrekcode-github-io",
  "private": true,
  "type": "module",
  "scripts": {
    "render:works": "node tools/render-works.mjs",
    "sync": "node tools/render-works.mjs && node tools/sync-site.mjs",
    "minify:client": "node tools/minify-scroll-top.mjs",
    "fix:wp-export-a11y": "node tools/fix-wp-export-access-dl.mjs",
    "optimize-images": "node tools/optimize-images.mjs",
    "build:icons": "node tools/build-skill-icons.mjs",
    "validate": "html-validate index.html about.html 404.html projects/open-cafe/index.html projects/open-cafe/site/index.html",
    "verify:partials": "node tools/verify-partials.mjs",
    "lint:links": "node tools/lint-links.mjs",
    "lint:a11y": "node tools/lint-a11y.mjs",
    "verify:og": "node tools/verify-og-images.mjs",
    "smoke:html": "node tools/smoke-html.mjs",
    "lint:js": "eslint tools",
    "audit:ci": "npm audit --audit-level=high",
    "deps:report": "npm outdated || true",
    "task:next": "node tools/next-task.mjs",
    "sync:check": "npm run validate && npm run sync && npm run validate && npm run verify:partials && npm run smoke:html",
    "check": "npm run sync && npm run minify:client && npm run build:icons && npm run validate && npm run verify:partials && npm run verify:og && npm run smoke:html && npm run lint:js && npm run lint:links && npm run lint:a11y && npm run audit:ci",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "html-validate": "^11.5.6",
    "jsdom": "^29.1.1",
    "linkinator": "^8.0.3",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.11.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
